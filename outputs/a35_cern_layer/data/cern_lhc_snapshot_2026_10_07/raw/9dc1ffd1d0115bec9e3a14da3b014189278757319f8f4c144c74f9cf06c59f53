            // Toggle between showing and hiding the sidebar, and add overlay effect
            function w3_open() {
                if (mySidebar.style.display === 'block') {
                    mySidebar.style.display = 'none';
                    overlayBg.style.display = "none";
                } else {
                    mySidebar.style.display = 'block';
                    overlayBg.style.display = "block";
                }
            }
            // Close the sidebar with the close button
            function w3_close() {
                mySidebar.style.display = "none";
                overlayBg.style.display = "none";
            }

            function hide_show(section){
                var header = document.getElementById(section+"_header");
                var elements = document.getElementsByClassName(section+"_section");
                var show = false;
                var text = "Tables";
                if (section == 'figures'){
                    text = "Figures";
                } else if (section == 'auxiliary'){
                    text = "Auxiliary material";
                } else if (section == 'animated'){
                    text = "Animated plots";
                }
                var w = window.innerWidth;
                for (var i=0; i<elements.length; i++){
                    if (elements[i].style.display == "flex" || elements[i].style.display == "" || elements[i].style.display == "block"){
                        elements[i].style.display = "none";
                        show = false
                    }else{
                        if (w <= 800){
                            elements[i].style.display = "block";
                        }else{
                            elements[i].style.display = "flex";
                        }
                        show = true;
                    }
                }
                if (show){
                    header.innerHTML = '<b>'+text+'</b> <i class="fa-solid fa-circle-up show_hide_arrows"></i>'
                }else{
                    header.innerHTML = '<b>'+text+'</b> <i class="fa-solid fa-circle-down show_hide_arrows"></i>'
                }
            }

