<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E1.m1" class="ltx_math_unparsed" alttext="uu\rightarrow\textrm{QBH}^{4/3}\rightarrow\bar{d}\ell^{+},\quad ud\rightarrow\textrm{QBH}^{1/3}\rightarrow\bar{u}\ell^{+},\quad dd\rightarrow\textrm{QBH}^{-2/3}\rightarrow\bar{d}\ell^{-}," display="block" intent=":literal"><semantics><mrow><mi>u</mi><mi>u</mi><mo stretchy="false">→</mo><mtext>QBH</mtext><msup><mrow></mrow><mrow><mn>4</mn><mo>/</mo><mn>3</mn></mrow></msup><mo stretchy="false">→</mo><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>+</mo></msup><mo rspace="1.167em">,</mo><mi>u</mi><mi>d</mi><mo stretchy="false">→</mo><mtext>QBH</mtext><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo stretchy="false">→</mo><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>+</mo></msup><mo rspace="1.167em">,</mo><mi>d</mi><mi>d</mi><mo stretchy="false">→</mo><mtext>QBH</mtext><msup><mrow></mrow><mrow><mo>−</mo><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo stretchy="false">→</mo><mover accent="true"><mi>d</mi><mo>¯</mo></mover><mi mathvariant="normal">ℓ</mi><msup><mrow></mrow><mo>−</mo></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">uu\rightarrow\textrm{QBH}^{4/3}\rightarrow\bar{d}\ell^{+},\quad ud\rightarrow\textrm{QBH}^{1/3}\rightarrow\bar{u}\ell^{+},\quad dd\rightarrow\textrm{QBH}^{-2/3}\rightarrow\bar{d}\ell^{-},</annotation></semantics></math></td>
