{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sl-collider:benchmark:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "object_class": {
      "enum": [
        "QUANTUM_BLACK_HOLE",
        "SEMICLASSICAL_BLACK_HOLE",
        "STRING_BALL",
        "SPHALERON",
        "GENERIC_HIGH_MULTIPLICITY"
      ]
    },
    "model_family": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        {
          "type": "null"
        }
      ]
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        {
          "type": "null"
        }
      ]
    },
    "n_extra_dimensions": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "model_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "role": {
            "enum": [
              "FIXED",
              "SCAN"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "name",
          "role",
          "value",
          "definition"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "assumptions": {
      "type": "object",
      "properties": {
        "generator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "pdf": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold_convention": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "fundamental_scale_definition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "spin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "charge": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "lifetime": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "decay_regime": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "branching_ratios": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "loss_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "remnant": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "generator",
        "pdf",
        "threshold_convention",
        "fundamental_scale_definition",
        "spin",
        "charge",
        "lifetime",
        "decay_regime",
        "branching_ratios",
        "loss_model",
        "remnant"
      ],
      "additionalProperties": false
    },
    "validity_domain": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "source_id",
          "source_version",
          "sha256",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "purpose": {
      "enum": [
        "RESEARCH",
        "TEST_FIXTURE"
      ]
    }
  },
  "required": [
    "schema_version",
    "benchmark_id",
    "object_class",
    "model_family",
    "model_version",
    "n_extra_dimensions",
    "model_parameters",
    "assumptions",
    "validity_domain",
    "provenance",
    "purpose"
  ],
  "additionalProperties": false
}
