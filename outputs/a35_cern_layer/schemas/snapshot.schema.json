{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sl-collider:snapshot:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "cutoff_date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "status": {
      "enum": [
        "FROZEN_PARTIAL",
        "FROZEN_COMPLETE"
      ]
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "normalizer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "constraint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "scope",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "unavailable_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "cutoff_date",
    "created_at",
    "status",
    "parser_version",
    "normalizer_version",
    "sources",
    "artifacts",
    "constraint_ids",
    "gaps",
    "unavailable_receipts",
    "supersedes"
  ],
  "additionalProperties": false
}
